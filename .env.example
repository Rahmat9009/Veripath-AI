# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Origin of the separately deployed backend, for example
# https://veripath-api.example.com — no trailing slash and no /api suffix, as
# the frontend appends the full /api/... path itself.
#
# Only VITE_-prefixed variables reach the browser bundle, and Vite inlines them
# at BUILD time: set this in the Vercel project's environment variables before
# the build runs. Changing it later requires a rebuild, not just a redeploy.
#
# Leave it empty for local development. `npm run dev` serves the frontend and
# the API from one Express process on one origin, so an empty base keeps every
# request on the relative /api/... path it has always used.
#
# Never move a secret behind this prefix. GEMINI_API_KEY above is read only by
# server.ts and must stay unprefixed — renaming it to VITE_GEMINI_API_KEY would
# publish the key to every visitor's browser.
VITE_API_BASE_URL=""
